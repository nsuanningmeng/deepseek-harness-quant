# 单独复制为 config/autotrade.yaml；真实账户/Token 不写入此文件。
mode: paper
runtime_dir: runtime/autotrade
data:
  provider: files
  directory: runtime/autotrade/market
  universe: []  # files 从快照读取；tushare 必须显式指定有权限的 A 股池
strategy:
  name: turn_low
  lookback: 20
  top_n: 10
  rebalance_sessions: 40
  target_gross: 0.75
  max_price_deviation: 0.05
  min_listing_days: 180
  min_volume: 10000
  exclude_st: true
  allowed_boards: [MAIN, CHINEXT, STAR, BSE]
broker:
  initial_cash: 1000000
  commission_rate: 0.0003
  min_commission: 5
  stamp_tax_rate: 0.0005
  transfer_fee_rate: 0.00001
  slippage_bps: 5
  max_volume_fraction: 0.01
risk:
  max_symbol_weight: 0.15
  max_total_weight: 0.80
  max_order_weight: 0.15
  max_sector_weight: 0.40
  max_drawdown: 0.15
  max_daily_orders: 100
  max_order_notional: 150000
  kill_switch_file: runtime/autotrade/STOP
boards:
  MAIN: {min_buy: 100, buy_step: 100, max_order: 1000000, price_tick: 0.01}
  CHINEXT: {min_buy: 100, buy_step: 100, max_order: 300000, price_tick: 0.01}
  STAR: {min_buy: 200, buy_step: 1, max_order: 100000, price_tick: 0.01}
  BSE: {min_buy: 100, buy_step: 1, max_order: 1000000, price_tick: 0.01}
schedule:
  after_close: '16:30'
  poll_seconds: 60
  health_max_age_seconds: 172800
qmt:
  enabled: false
  broker_permission_confirmed: false
  manual_authorization: false
  account_id: ''
  userdata_path: ''
