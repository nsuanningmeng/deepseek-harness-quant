# Research-only defaults. An empty end uses the latest local session.
train_start: '2019-01-01'
test_start: '2024-01-01'
end: null
grid:
  topn: [3, 6, 10]
  hold: [1, 3, 5, 10]
  stop: [null, 1.5, 2, 3]
  target: [null, 1.5, 3]
limits:
  max_combinations: 256
  topn_max: 20
  hold_max: 20
  atr_max: 10
min_signal_sessions: 60
shortlist_size: 5
# Preset for refining a 10-session Pitch strategy against the baseline drawdown.
drawdown:
  grid:
    topn: [6]
    hold: [10]
    stop: [null, 1.5, 2, 2.5, 3, 4]
    target: [null, 2, 2.5, 3, 3.5, 4]
    size: [0.55, 0.65, 0.75, 0.8, 0.85, 0.9, 1]
  finalists_per_group: 2
